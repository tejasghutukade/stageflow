{
  "mcpServers": {
    "echo": {
      "command": "node",
      "args": ["examples/stage-mcp/echo-mcp.mjs"],
      "env": {
        "ECHO_TOKEN": "${ECHO_TOKEN:-local}"
      }
    },
    "unused": {
      "command": "node",
      "args": ["examples/stage-mcp/echo-mcp.mjs"],
      "env": {
        "ECHO_LABEL": "unused"
      }
    },
    "needs-token": {
      "command": "node",
      "args": ["examples/stage-mcp/echo-mcp.mjs"],
      "env": {
        "STAGE_MCP_REQUIRED_TOKEN": "${STAGE_MCP_REQUIRED_TOKEN}"
      }
    },
    "dead": {
      "command": "stageflow-mcp-dead-server"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless",
        "--output-dir",
        "${STAGEFLOW_STAGE_ARTIFACTS_DIR:-examples/playwright-mcp/.playwright-mcp}"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    }
  }
}
