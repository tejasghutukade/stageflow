root = Stack([header, stats, callouts, tags, textSizes, comparison, bars, trend], "column", "l")
header = Card([CardHeader("Component gallery", "Static content: no bindings, nothing refreshes"), TextContent("Every component in the Stageflow OpenUI library, with inline data.")], "card", "column", "s")
stats = Stack([Stat("Runs today", "128", "ok"), Stat("Needs input", "3", "needs"), Stat("Failed", "1", "fail"), Stat("In flight", "7", "running"), Stat("Idle", "42", "neutral")], "row", "m", "center", "start", true)
callouts = Stack([Callout("info", "Info", "Neutral information."), Callout("success", "Success", "Everything passed."), Callout("warning", "Warning", "One check is slow."), Callout("error", "Error", "A stage failed."), Callout("neutral", "Neutral", "A plain note.")], "column", "s")
tags = Card([CardHeader("Tags and pills"), Stack([Tag("neutral", null, "md", "neutral"), Tag("info", null, "md", "info"), Tag("success", null, "md", "success"), Tag("warning", null, "md", "warning"), Tag("danger", null, "md", "danger"), StatusPill("ok", "ok"), StatusPill("fail", "fail")], "row", "s", "center", "start", true)])
textSizes = Card([CardHeader("Text sizes"), TextContent("small", "small"), TextContent("default"), TextContent("large", "large"), TextContent("small-heavy", "small-heavy"), TextContent("large-heavy", "large-heavy")], "sunk", "column", "xs")
comparison = Card([CardHeader("Plan comparison"), Table([Col("Plan", ["Free", "Team", "Scale"]), Col("Seats", [3, 25, 250], "number"), Col("Price", ["$0", "$49", "$399"])])])
bars = Card([CardHeader("Stacked bars"), BarChart(["Mon", "Tue", "Wed", "Thu", "Fri"], [Series("Passed", [12, 15, 14, 18, 20]), Series("Failed", [2, 1, 3, 0, 1])], "stacked", "Day", "Runs", 220)])
trend = Card([CardHeader("Step line"), LineChart(["Q1", "Q2", "Q3", "Q4"], [Series("2025", [10, 14, 13, 19]), Series("2026", [12, 18, 21, 27])], "step", "Quarter", "Score", 220)])
