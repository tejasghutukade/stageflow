# Copy to `.env` at the repo root for `docker compose` local try.
# Compose loads `.env` automatically. Do not commit `.env`.
#
# Shell environment overrides Compose `.env`. An empty exported
# GITHUB_TOKEN / GH_TOKEN blanks the container token — use:
#   env -u GITHUB_TOKEN -u GH_TOKEN docker compose up --build -d
# See docs/docker.md (Local try).

# Required (≥32 characters, no whitespace). Image binds 0.0.0.0.
STAGEFLOW_CONTROL_TOKEN=

# Host clone/fetch askpass (needed even for public repos). Also available
# for stage `secrets:` grants. Compose maps GH_TOKEN from GITHUB_TOKEN when
# GH_TOKEN is unset.
GITHUB_TOKEN=
# GH_TOKEN=

# Host boot provider credentials (STAGEFLOW_PROVIDER_* — not bare OPENROUTER_API_KEY alone).
# STAGEFLOW_PROVIDER_OPENROUTER_API_KEY=
# STAGEFLOW_PROVIDER_ANTHROPIC_API_KEY=
