# Copy to `.env` at the repo root for `docker compose` local try.
# Compose loads `.env` automatically. Do not commit `.env`.
#
# Shell environment overrides Compose `.env`. An empty exported
# GITHUB_TOKEN / GH_TOKEN blanks the container token — use:
#   env -u GITHUB_TOKEN -u GH_TOKEN docker compose up --build -d
# See docs/docker.md (Local try).

# Unused by the shipped compose file, which publishes 127.0.0.1:3847 only and
# sets STAGEFLOW_ALLOW_UNAUTHENTICATED_BIND=1. Set this (≥32 characters, no
# whitespace) if you remove that opt-in or publish the port beyond localhost.
# STAGEFLOW_CONTROL_TOKEN=

# Host clone/fetch askpass (needed even for public repos). Also available
# for stage `secrets:` grants. Compose maps GH_TOKEN from GITHUB_TOKEN when
# GH_TOKEN is unset.
GITHUB_TOKEN=
# GH_TOKEN=

# Host boot provider credentials (STAGEFLOW_PROVIDER_* — not bare OPENROUTER_API_KEY alone).
# STAGEFLOW_PROVIDER_OPENROUTER_API_KEY=
# STAGEFLOW_PROVIDER_ANTHROPIC_API_KEY=

# Triggers readiness smoke (examples/triggers-readiness in the Docker image)
# WEBHOOK_SECRET=
# EMAIL_PASSWORD=

# Agents (see docs/environment-variables.md). Leave unset for the defaults.
# STAGEFLOW_MCP_ENV_ALLOW=LINEAR_API_KEY      # Host env names agents may use to fill ${NAME} in MCP servers
# STAGEFLOW_PUBLIC_CHAT_ORIGINS=https://chat.example.com
# STAGEFLOW_AGENT_CHANNEL_LISTENERS=0         # stop holding AgentMail/iMessage streams
# STAGEFLOW_AGENT_SCHEDULE_TICK_INTERVAL_MS=30000
# Not in docker-compose.yml: STAGEFLOW_AGENT_SESSION_IDLE_MINUTES, STAGEFLOW_AGENT_STALL_SECONDS (empty = 0 = off).
